# Copy to .env and fill in values. Never commit .env.

# Database (matches docker-compose defaults)
DATABASE_URL=postgresql://britney:britney_dev@localhost:5432/britney

# OpenAI — server-side only
OPENAI_API_KEY=sk-...

# Optional: Alpaca paper trading (later)
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# CoinGecko is public; no key required for free tier

# Firebase Admin — path to service account JSON OR leave empty to skip auth in dev
FIREBASE_CREDENTIALS_PATH=

# Set true only for local dev without Firebase (NOT for production)
AUTH_DISABLED=false

# CORS — Flutter web / mobile dev
CORS_ORIGINS=http://localhost:3000,http://localhost:8080,http://127.0.0.1:8080
