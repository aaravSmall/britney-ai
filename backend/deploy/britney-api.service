[Unit]
Description=britney.ai FastAPI web app
After=network-online.target postgresql.service
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=britney
Group=britney
WorkingDirectory=/opt/britney-ai/backend
EnvironmentFile=/opt/britney-ai/backend/.env
ExecStart=/opt/britney-ai/backend/.venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 8000
Restart=always
RestartSec=10

# Same sandboxing profile as britney-agent.service — network plus its own
# working dir + Postgres over localhost, nothing else.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/opt/britney-ai

[Install]
WantedBy=multi-user.target
