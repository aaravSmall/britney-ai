# britney.ai trading agent — droplet environment file.
#
# Copy to backend/.env on the droplet (provision.sh does this
# automatically on first run) and fill in real values. NEVER commit the
# resulting .env — it's gitignored, same as local dev's backend/.env.

# Required. provision.sh creates the Postgres role/database and fills
# this in automatically the first time it creates backend/.env — you
# only need to touch this by hand if you're pointing at a different DB
# (e.g. after promoting to a managed Postgres add-on, see docs/IDEAS.txt).
DATABASE_URL=postgresql://britney:CHANGE_ME@localhost:5432/britney

# Required for real stock/ETF news ingestion (https://finnhub.io free
# tier). Leave empty and the agent runs on deterministic offline mock
# articles instead (backend/agent/news_ingestion.py) — it'll still run,
# just without real news.
FINNHUB_API_KEY=

# Required for real crypto news ingestion (https://cryptopanic.com free
# "Developer" tier — sign up and grab your auth token from
# https://cryptopanic.com/developers/api/). Covers BTC/ETH/SOL, which
# Finnhub's free endpoint above doesn't. Leave empty and the agent runs
# on deterministic offline mock articles instead
# (backend/agent/news_ingestion.py) — it'll still run, just without real
# crypto news.
CRYPTOPANIC_API_KEY=

# Required for real LLM sentiment scoring (https://platform.openai.com).
# Leave empty and the agent falls back to a keyword-heuristic mock score
# (backend/agent/sentiment.py) instead of calling OpenAI.
OPENAI_API_KEY=

# Optional — only used if you want stock prices from Alpaca instead of
# the free Yahoo Finance endpoint app/services/market_data.py already
# falls back to. Leave empty to just use Yahoo.
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# Optional — also write agent logs to this file (with rotation), in
# addition to journald. Leave unset to rely on `journalctl -u
# britney-agent` alone, which needs no extra setup. If you do set this,
# make sure the directory is owned by the britney user (provision.sh
# creates /var/log/britney-agent for you) and that the path is covered by
# ReadWritePaths= in britney-agent.service.
# AGENT_LOG_FILE=/var/log/britney-agent/agent.log

# Not used by the agent — backend/agent/run_agent.py never imports the
# FastAPI app (app/main.py) or its auth layer (app/deps.py,
# app/services/firebase_auth.py), so none of these matter on an
# agent-only droplet. Only relevant if this droplet later also runs the
# API server alongside the agent.
# FIREBASE_CREDENTIALS_PATH=
# AUTH_DISABLED=
# CORS_ORIGINS=
