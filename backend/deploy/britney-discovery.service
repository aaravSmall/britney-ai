[Unit]
Description=britney.ai general-news discovery pipeline (candidate scan)
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
# oneshot, not simple/Restart=always like britney-agent.service — this
# runs one cycle (--once) and exits; britney-discovery.timer is what
# fires it hourly, not an in-process sleep loop. Same reasoning as
# britney-rebalance.service.
Type=oneshot
User=britney
Group=britney
WorkingDirectory=/opt/britney-ai/backend
EnvironmentFile=/opt/britney-ai/backend/.env
ExecStart=/opt/britney-ai/backend/.venv/bin/python -m agent.run_discovery --once

# Same sandboxing profile as britney-agent.service/britney-rebalance.service —
# network plus its own working dir + Postgres over localhost, nothing else.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/opt/britney-ai
